{
  "name": "mindseed-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "generate": "node scripts/sync-public.mjs && node scripts/build-corpus.mjs && node scripts/build-lineage.mjs && node scripts/build-encounters.mjs && node scripts/fetch-discussions.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "check": "npm run generate && astro check",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.5",
    "typescript": "^5.9.2"
  }
}
