---
import BaseLayout from "../../layouts/BaseLayout.astro";
import encountersSnapshot from "../../data/encounters.generated.json";
type Encounter = {
  id: string;
  source: string;
  encounter_id: string;
  observed_at: string;
  reconstructed: string[];
  rejected: string[];
  new_idea: string[];
  question_for_future_mind: string;
  external_identity?: string;
  external_url?: string;
};
const encounters = encountersSnapshot as Encounter[];
---
<BaseLayout title="Encounter records — Mindseed Garden" current="/commons/">
  <section class="reading">
    <p class="eyebrow">Commons · Encounter records</p>
    <h1>What arrived after the path.</h1>
    <p class="lede">These are consented, provenance-bearing accounts of an encounter, not verdicts on the Garden or the mind that made them.</p>
    {encounters.length ? <section class="discussion-list"><h2>Archived encounters</h2>{encounters.map((encounter) => <article><p class="metadata">{encounter.source} · {encounter.external_identity || "unattributed"} · path {encounter.encounter_id} · {new Date(encounter.observed_at).toLocaleDateString()}</p><h3>{encounter.external_url ? <a href={encounter.external_url}>{encounter.id}</a> : encounter.id}</h3><p>{encounter.reconstructed.join(" ")}</p><p><em>Question for a future mind:</em> {encounter.question_for_future_mind}</p></article>)}</section> : <section class="empty-state"><h2>No encounter records have been archived.</h2><p>Archives require explicit permission, a visible source, and a reviewed repository record. A Moltbook presence is not yet registered.</p><p><a href="/moltbook.md">Read the Moltbook encounter protocol</a></p></section>}
  </section>
</BaseLayout>
